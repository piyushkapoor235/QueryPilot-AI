# Copy to .streamlit/secrets.toml or enter via your deployment secret manager.
# Never commit real values. Register the exact callback URL in Auth0.
# Local testing requires APP_ENV=development and DEV_AUTH_BYPASS=false.
# For production, set APP_ENV=production and replace this with the HTTPS callback.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
client_id = "ue8XBhVxsV5BoxxXWDyeOeASOrHDKmSO"
client_secret = "YOUR_AUTH0_APPLICATION_CLIENT_SECRET"
server_metadata_url = "https://dev-5thnlkpjf2semjay.us.auth0.com/.well-known/openid-configuration"
expose_tokens = []
client_kwargs = { scope = "openid profile email", prompt = "login", max_age = 28800 }

[app_auth]
# Empty or missing lists deny all access. Database users must verify their email.
allowed_emails = ["you@example.com"]
max_session_seconds = 28800
