GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Local OIDC testing; set production and an HTTPS callback when deploying.
APP_ENV=development
DEV_AUTH_BYPASS=false
# Development defaults to .querypilot/application.db (SQLite, ignored by Git).
# Production requires PostgreSQL and a one-time schema initialization:
# QUERYPILOT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/querypilot?sslmode=require
# Customer SQL connections: company-ID -> reference -> private PostgreSQL URL.
# Provision with deployment secrets; see docs/data-sources.md. No real values here.
# QUERYPILOT_DATA_CONNECTIONS={}
# PGSSLROOTCERT=path_to_customer_database_CA_certificate
